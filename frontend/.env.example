# Frontend environment (copy to .env and fill in).
# These are embedded into the built JS bundle — PUBLIC values only.
# OpenAI / DB / Adobe secrets belong in backend/.env, never here.

VITE_API_URL=https://legal-api.gyftr.net

VITE_COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX

# Cognito Hosted UI domain — required only for the "Continue with Google"
# button (frontend/src/lib/auth-google-sso.js). Leave unset and the button
# stays hidden; the email/password path above is unaffected either way.
# See docs/GOOGLE-SSO-RUNBOOK.md for how to set this up.
# VITE_COGNITO_DOMAIN=gyftr-legal.auth.ap-south-1.amazoncognito.com

# Google integration (restrict keys by HTTP referrer in Google Cloud Console)
# VITE_GOOGLE_DOCS_API_KEY=
# VITE_GOOGLE_DRIVE_API_KEY=
# VITE_GOOGLE_PICKER_API_KEY=
# VITE_GOOGLE_OAUTH_CLIENT_ID=
