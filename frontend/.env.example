# Frontend environment (copy to .env and fill in).
# These are embedded into the built JS bundle — PUBLIC values only.
# OpenAI / DB / Adobe secrets belong in backend/.env, never here.

VITE_API_URL=https://legal-api.gyftr.net

VITE_COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX

