# Copy to .env on the EC2 instance (or for local dev). Never commit .env.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=7978
FRONTEND_URL=https://your-frontend-domain.example

# ── Database (RDS Postgres) — used only if AWS_SECRET_NAME is unset ─────────
DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_PORT=5432
DB_NAME=gyftr_legal
DB_USER=gyftr_admin
DB_PASSWORD=your_db_password

# ── Optional: pull DB credentials from Secrets Manager instead of DB_* above ─
# If set, DB_* vars above are ignored.
# AWS_SECRET_NAME=gyftr/legal/db
# AWS_REGION=ap-south-1

# ── AWS Cognito ───────────────────────────────────────────────────────────────
COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
COGNITO_CLIENT_ID=your_cognito_client_id
COGNITO_REGION=ap-south-1

# ── S3 (private bucket for draft files, replaces the Supabase Storage bucket) ─
DRAFTS_BUCKET=gyftr-legal-drafts

# ── AI clause analysis (OpenAI — unrelated to this migration, kept as-is) ────
OPENAI_API_KEY=your-openai-key

# ── Adobe Sign (e-signature — unrelated to this migration, kept as-is) ──────
ADOBE_CLIENT_ID=your-adobe-client-id
ADOBE_CLIENT_SECRET=your-adobe-client-secret
