# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local — it is gitignored.

# Backend API — EC2/ALB endpoint (see infra/aws-setup.md)
VITE_API_URL=https://api.your-domain.example

# AWS Cognito — from the Cognito User Pool console
VITE_COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=your_cognito_client_id

# NOTE: there is no OpenAI key here. It is server-side only
# (backend/.env OPENAI_API_KEY). Never add it to this file — VITE_ variables
# are compiled into the public bundle, where anyone can read them.

# Google integration (Picker / Drive / Docs).
# Restrict the API keys by HTTP referrer in the Google Cloud Console.
VITE_GOOGLE_DOCS_API_KEY=your-google-docs-api-key
VITE_GOOGLE_DRIVE_API_KEY=your-google-drive-api-key
VITE_GOOGLE_PICKER_API_KEY=your-google-picker-api-key
VITE_GOOGLE_OAUTH_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com

# --- Server-side secrets (OPENAI_API_KEY, ADOBE_CLIENT_ID/SECRET, DB creds)
#     live in backend/.env on the EC2 instance, not here — see
#     backend/.env.example and infra/aws-setup.md. ---
