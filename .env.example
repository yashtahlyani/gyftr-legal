# Root env for docker-compose (copy to .env and fill in)
# Frontend Vite vars are baked at image build time.

# ── URLs ────────────────────────────────────────────────────────────────────
# Production: frontend https://legal.gyftr.net | backend https://legal-api.gyftr.net
# For local docker compose use the localhost values instead.
VITE_API_URL=https://legal-api.gyftr.net
FRONTEND_URL=https://legal.gyftr.net

# ── Cognito ─────────────────────────────────────────────────────────────────
VITE_COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX
COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX
COGNITO_REGION=ap-south-1

# ── Server ──────────────────────────────────────────────────────────────────
PORT=7978

# ── Database (or use AWS_SECRET_NAME) ───────────────────────────────────────
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=gyftr_legal
DB_USER=gyftr_admin
DB_PASSWORD=your_db_password
# AWS_SECRET_NAME=gyftr/legal/db
# AWS_REGION=ap-south-1

# ── Optional frontend build-time keys (public only) ─────────────────────────
# OpenAI key is SERVER-SIDE only — set OPENAI_API_KEY in backend/.env, never here.
# VITE_GOOGLE_DOCS_API_KEY=
# VITE_GOOGLE_DRIVE_API_KEY=
# VITE_GOOGLE_PICKER_API_KEY=
# VITE_GOOGLE_OAUTH_CLIENT_ID=

# ── Backend extras ──────────────────────────────────────────────────────────
DRAFTS_BUCKET=gyftr-legal-drafts
# OPENAI_API_KEY=
# ADOBE_CLIENT_ID=
# ADOBE_CLIENT_SECRET=
