# Root .env — used by docker-compose only (see docker-compose.yml).
# Copy to .env and fill in. Never commit the filled-in file.
#
# Deploying to AWS instead of Docker? These are not the files you want:
#   frontend/.env.example   VITE_* values, baked into the bundle at build time
#   backend/.env.example    runtime config for the API on EC2/ECS

# Cognito — required even locally; there is no local substitute.
COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX
AWS_REGION=ap-south-1

# Local Postgres (the db service). Not the RDS credentials.
DB_NAME=gyftr_legal
DB_USER=gyftr_admin
DB_PASSWORD=localdev

# Server-side secrets. NEVER give these a VITE_ prefix — Vite compiles VITE_
# variables into the public bundle, which is how the previous OpenAI key was
# exposed to every user of the portal.
OPENAI_API_KEY=
DRAFTS_BUCKET=gyftr-legal-drafts

# Google integration — the OAuth client ID is public by design.
VITE_GOOGLE_OAUTH_CLIENT_ID=
